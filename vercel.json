{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ats-checker", "destination": "/ats-checker.html" },
    { "source": "/cover-letter", "destination": "/cover-letter.html" },
    { "source": "/interview-prep", "destination": "/interview-prep.html" },
    { "source": "/job-matcher", "destination": "/job-matcher.html" },
    { "source": "/mock-interview", "destination": "/mock-interview.html" },
    { "source": "/salary-estimator", "destination": "/salary-estimator.html" },
    { "source": "/test-series", "destination": "/test-series.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|json|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!.*\\.(?:css|js|png|jpg|jpeg|svg|json|woff2)$).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}